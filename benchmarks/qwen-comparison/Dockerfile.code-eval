FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534
RUN pip install --no-cache-dir numpy==2.3.3 psutil==7.1.0
COPY evalplus /opt/vendor/evalplus
COPY LICENSE /opt/vendor/LICENSE.evalplus
LABEL evalplus.commit="26d6d00bb1fd0fa37f39c99d5290da67891d1c5e"
ENV PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["python", "-I", "-"]
